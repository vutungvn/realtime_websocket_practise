{
  "name": "bai8-ops-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Bai tap 8 - Bang dieu khien van hanh: SSE + heartbeat qua load balancer 60s",
  "scripts": {
    "server": "ts-node src/server/main.ts",
    "lb": "ts-node src/tools/run-lb.ts",
    "compare": "ts-node src/experiment/compare.ts",
    "test": "jest --runInBand --verbose",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "cross-env": "^10.1.0",
    "eventsource": "^3.0.7",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "~5.8"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": ".",
    "testMatch": [
      "<rootDir>/test/**/*.spec.ts"
    ],
    "testTimeout": 30000,
    "setupFiles": [
      "<rootDir>/test/env.ts"
    ]
  }
}
